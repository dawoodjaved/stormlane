# Copy to .env and fill in. Never commit .env.

# --- Backend (Django) ---
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# Leave empty to use the in-memory cache. docker-compose sets this to its Redis service.
REDIS_URL=

# HERE Routing v8 + Geocoding & Search (https://platform.here.com)
HERE_API_KEY=

# Open-Meteo needs no key
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- Frontend (Vite) ---
# Leave empty in local dev; Vite proxies /api to the backend.
# Set to the deployed backend origin in production, e.g. https://stormlane-api.onrender.com
VITE_API_URL=
